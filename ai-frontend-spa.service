[Unit]
Description=AI Detection Frontend SPA (Port 3005)
After=network.target graphical-session.target ai-backend.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/wenyili/projects/AI-Detection
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=-/bin/bash -c '/usr/bin/fuser -k -TERM 3005/tcp 2>/dev/null; sleep 1; /usr/bin/fuser -k -KILL 3005/tcp 2>/dev/null; true'
ExecStart=/home/wenyili/projects/AI-Detection/venv/bin/python /home/wenyili/projects/AI-Detection/serve_spa.py --port 3005 --dir /home/wenyili/projects/AI-Detection/dist --cert /home/wenyili/projects/AI-Detection/server.crt --key /home/wenyili/projects/AI-Detection/server.key --backend http://127.0.0.1:8000
Restart=always
RestartSec=3
StartLimitIntervalSec=120
StartLimitBurst=15

[Install]
WantedBy=graphical-session.target

[Unit]
Description=AI Detection Backend WSGI
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/wenyili/projects/AI-Detection/backend
Environment="PATH=/home/wenyili/projects/AI-Detection/venv/bin:/usr/bin:/bin"
Environment="PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True"
Environment="HF_HUB_OFFLINE=1"
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=-/bin/bash -c '/usr/bin/fuser -k -TERM 8000/tcp 2>/dev/null; sleep 2; /usr/bin/fuser -k -KILL 8000/tcp 2>/dev/null; true'
ExecStart=/home/wenyili/projects/AI-Detection/venv/bin/python /home/wenyili/projects/AI-Detection/backend/serve_production.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
StartLimitIntervalSec=120
StartLimitBurst=15
MemoryHigh=2.0G
MemoryMax=2.5G

[Install]
WantedBy=graphical-session.target

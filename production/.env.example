# AI检测系统生产环境配置示例
# ============================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 修改下面的配置值为实际的生产环境值
# 3. 确保 .env 文件不被提交到版本控制系统
# ============================================

# ===================
# 数据库配置
# ===================
POSTGRES_DB=qainspect
POSTGRES_USER=qainspect
# 请使用强密码，至少16个字符，包含大小写字母、数字和特殊字符
POSTGRES_PASSWORD=<生成一个强密码>
DB_HOST=db
DB_PORT=5432

# ===================
# Redis配置
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
# 请使用强密码
REDIS_PASSWORD=<生成一个强密码>

# ===================
# Django配置
# ===================
# 使用以下命令生成SECRET_KEY:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<生成一个随机密钥>

# 生产环境必须设为False
DEBUG=False

# 允许的主机名，多个用逗号分隔
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# CORS允许的来源，多个用逗号分隔
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===================
# 端口配置
# ===================
# 后端API直接访问端口
APP_PORT=8012
# 前端HTTP访问端口
HTTP_PORT=80
# 前端HTTPS访问端口
HTTPS_PORT=443

# ===================
# 邮件配置（可选）
# ===================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<你的邮箱>
EMAIL_HOST_PASSWORD=<邮箱密码或应用专用密码>

# ===================
# 文件存储配置
# ===================
MEDIA_ROOT=/app/backend/media
STATIC_ROOT=/app/backend/static

# ===================
# 日志配置
# ===================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log

# ===================
# AI模型配置
# ===================
MODEL_PATH=/app/backend/models
YOLO_MODEL_PATH=/app/backend/models/yolo

# ===================
# 安全配置
# ===================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# ===================
# 性能配置
# ===================
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=2
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# ===================
# Celery配置
# ===================
# 注意：URL中的密码需要与REDIS_PASSWORD保持一致
CELERY_BROKER_URL=redis://:<REDIS密码>@redis:6379/0
CELERY_RESULT_BACKEND=redis://:<REDIS密码>@redis:6379/0
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai

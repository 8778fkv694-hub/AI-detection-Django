# AI检测系统生产环境配置示例
# 复制此文件为 .env 并修改相应的配置值

# ===================
# 数据库配置
# ===================
POSTGRES_DB=qainspect
POSTGRES_USER=qainspect
POSTGRES_PASSWORD=your_secure_password_here
DB_HOST=db
DB_PORT=5432

# ===================
# Redis配置
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ===================
# Django配置
# ===================
SECRET_KEY=YtVAlqT8d8mMWu15gAYXBIRusKYuHrGLAzLmAbRyA9w=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,https://your-domain.com,http://localhost:8012,https://localhost:8012

# ===================
# 端口配置
# ===================
# 后端API直接访问端口
APP_PORT=8012
# 前端HTTP访问端口
HTTP_PORT=80
# 前端HTTPS访问端口
HTTPS_PORT=443
# 数据库端口
DB_PORT=5432
# Redis端口
REDIS_PORT=6379

# ===================
# 邮件配置（可选）
# ===================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password

# ===================
# 文件存储配置
# ===================
MEDIA_ROOT=/app/backend/media
STATIC_ROOT=/app/backend/static

# ===================
# 日志配置
# ===================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log

# ===================
# AI模型配置
# ===================
MODEL_PATH=/app/backend/models
YOLO_MODEL_PATH=/app/backend/models/yolo

# ===================
# 安全配置
# ===================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# ===================
# 性能配置
# ===================
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=2
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# ===================
# Celery配置
# ===================
CELERY_BROKER_URL=redis://:your_redis_password_here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your_redis_password_here@redis:6379/0
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai

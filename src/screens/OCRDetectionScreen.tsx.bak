  const [imageQualityMetrics, setImageQualityMetrics] = useState<any>(null); // 图像质量指标
  const [preprocessingRecommendation, setPreprocessingRecommendation] = useState<any>(null); // 预处理推荐
  const [processedImagePreview, setProcessedImagePreview] = useState<string | null>(null); // 预处理后的图片
  const [showImageComparison, setShowImageComparison] = useState(false); // 显示图像对比

# AI检测系统前端环境变量配置
# ============================================
# 使用说明:
# 1. 复制此文件为 .env.local 或 .env.production
# 2. 修改下面的配置值
# 3. Vite 会自动加载这些环境变量
# ============================================

# ===================
# API配置
# ===================
# 后端API主机名（生产环境必须设置）
VITE_API_HOST=your-api-domain.com

# 后端API端口（默认8012）
VITE_API_PORT=8012

# ===================
# Ollama本地AI配置（可选）
# ===================
# Ollama服务地址
VITE_OLLAMA_HOST=localhost

# Ollama服务端口
VITE_OLLAMA_PORT=11434
